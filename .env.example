MODEL_PATH=checkpoints/final
INFERENCE_BACKEND=transformers
EDSPIKE_API_KEY=replace-with-a-long-random-secret
LOG_LEVEL=INFO
MAX_BATCH_SIZE=64
GPU_MEMORY_UTILIZATION=0.90

# CPU / low-RAM settings
DEVICE=auto                        # "cpu" to force CPU inference / training
MODEL_QUANTIZATION=                # "int4" or "int8" for CPU 4/8-bit quantization
MAX_RAM_GB=0.8                     # warn if available RAM drops below this

